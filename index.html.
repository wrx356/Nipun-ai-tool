          <select id="img-size" class="bg-slate-950 border border-slate-700 rounded-xl px-3.5 py-3 text-sm text-slate-200 focus:outline-none focus:border-indigo-500">
            <option value="1024x1024">Square (1:1)</option>
            <option value="1280x720">Landscape (16:9)</option>
            <option value="720x1280">Portrait (9:16)</option>
          </select>
          <button onclick="generateImage()"
            class="bg-indigo-600 hover:bg-indigo-700 px-6 py-3 rounded-xl font-semibold text-sm transition shrink-0">
            ✨ Generate
          </button>
        </div>

        <div class="flex flex-wrap gap-2 text-xs">
          <span class="text-slate-400 py-1">Quick Prompts:</span>
          <button onclick="setPrompt('Minimalist modern workspace desk with glowing monitor, dark aesthetic, 4k')" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300">Modern Desk</button>
          <button onclick="setPrompt('Magical glowing forest waterfall at night, fantasy digital art, high detail')" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300">Fantasy Forest</button>
          <button onclick="setPrompt('Cute 3D robot character holding a coffee cup, studio lighting, pixar style')" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300">3D Robot</button>
