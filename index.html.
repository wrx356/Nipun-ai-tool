          <span>🖼️</span>
          <span>AI Image Studio</span>
        </button>

        <button data-tab="video" onclick="switchTab('video')"
          class="nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-left font-medium transition text-slate-300 hover:bg-slate-800">
          <span>🎬</span>
          <span>AI Video Studio</span>
        </button>

        <button data-tab="tools" onclick="switchTab('tools')"
