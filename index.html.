        <div class="flex flex-wrap items-center justify-between gap-3">
          <p id="img-caption" class="text-xs text-slate-400 truncate max-w-xl"></p>
          <a id="download-img-btn" href="#" download="nipun-ai-image.jpg" target="_blank" rel="noopener noreferrer"
            class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-sm font-medium transition">
            ⬇ Download Image
          </a>
        </div>
      </div>
    </section>

    <!-- 3. AI VIDEO STUDIO -->
    <section id="tab-video" class="tab-panel hidden max-w-4xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold mb-1">AI Video Studio</h2>
      <p class="text-sm text-slate-400 mb-6">Text Prompts සහ Scene Settings සකස් කර AI Video Generation Workflow එක සූදානම් කරන්න.</p>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-4">
        <div>
          <label class="block text-xs font-medium text-slate-300 mb-2">Video Scene Prompt</label>
          <textarea id="vid-prompt" rows="4"
            placeholder="උදා: Drone shot flying over misty green tea hills at sunrise, cinematic lighting, smooth camera movement..."
            class="w-full bg-slate-950 border border-slate-700 rounded-xl p-3.5 text-sm text-white focus:outline-none focus:border-indigo-500"></textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs text-slate-400 mb-1.5">Style</label>
            <select id="vid-style" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2.5 text-sm">
              <option>Cinematic</option>
              <option>3D Animation</option>
              <option>Sci-Fi / Cyberpunk</option>
              <option>Commercial / Product</option>
            </select>
          </div>
          <div>
            <label class="block text-xs text-slate-400 mb-1.5">Duration</label>
            <select id="vid-duration" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2.5 text-sm">
              <option>5 Seconds</option>
              <option>10 Seconds</option>
              <option>15 Seconds</option>
            </select>
          </div>
          <div>
            <label class="block text-xs text-slate-400 mb-1.5">Aspect Ratio</label>
            <select id="vid-ratio" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2.5 text-sm">
              <option>16:9 (YouTube / Landscape)</option>
              <option>9:16 (TikTok / Reels / Shorts)</option>
              <option>1:1 (Social Post)</option>
            </select>
          </div>
        </div>

        <button onclick="previewVideoBrief()"
          class="bg-indigo-600 hover:bg-indigo-700 px-6 py-3 rounded-xl font-semibold text-sm transition">
          🎬 Prepare Video Render Brief
        </button>

        <div id="vid-output" class="hidden mt-4 p-4 rounded-xl bg-slate-950 border border-indigo-500/30 text-sm space-y-2">
          <div class="text-indigo-300 font-semibold">Video Generation Brief Ready</div>
          <p id="vid-summary" class="text-slate-300 text-xs leading-relaxed"></p>
          <p class="text-[11px] text-slate-400">
            සජීවී Video Render කිරීමට Runway, Luma, Kling හෝ Replicate API Endpoint එකක් Backend/Serverless Function එකකට සම්බන්ධ කරන්න.
          </p>
        </div>
      </div>
    </section>

    <!-- 4. 50 AI TOOLS DIRECTORY -->
    <section id="tab-tools" class="tab-panel hidden max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold">50 AI Tools Directory</h2>
          <p class="text-sm text-slate-400">Writing, Image, Video, Audio, Coding, Marketing සහ Productivity සඳහා AI Tools 50ක්</p>
        </div>
        <div class="w-full md:w-80">
          <input id="tool-search" type="text" oninput="renderTools()"
            placeholder="Tool නම හෝ Category සොයන්න..."
            class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-indigo-500" />
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div id="category-filters" class="flex flex-wrap gap-2 mb-6"></div>

      <!-- Tools Count -->
      <div id="tools-count" class="text-xs text-slate-400 mb-4"></div>

      <!-- Tools Grid -->
      <div id="tools-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
    </section>

  </main>

  <script>
    // ---------- TAB NAVIGATION ----------
    function switchTab(tabName) {
      document.querySelectorAll('.tab-panel').forEach(panel => panel.classList.add('hidden'));
      document.getElementById('tab-' + tabName).classList.remove('hidden');

      document.querySelectorAll('.nav-btn').forEach(btn => {
        if (btn.dataset.tab === tabName) {
          btn.className = 'nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-left font-medium transition bg-indigo-600 text-white shadow-md shadow-indigo-600/20';
        } else {
          btn.className = 'nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-left font-medium transition text-slate-300 hover:bg-slate-800';
        }
      });
    }

    // ---------- NIPUN AI CHAT (GEMINI API + DEMO FALLBACK) ----------
    const apiKeyInput = document.getElementById('gemini-api-key');
    const savedKey = localStorage.getItem('nipun_gemini_key') || '';
    if (savedKey) apiKeyInput.value = savedKey;
    updateApiBadge();

    function saveApiKey() {
      const key = apiKeyInput.value.trim();
      if (key) {
        localStorage.setItem('nipun_gemini_key', key);
      } else {
        localStorage.removeItem('nipun_gemini_key');
      }
      updateApiBadge();
      appendMessage('ai', key ? 'Gemini API Key එක Save කරන ලදී. දැන් සජීවී පිළිතුරු ලැබේ!' : 'API Key එක ඉවත් කර Demo Mode ක්‍රියාත්මක කරන ලදී.');
    }

    function updateApiBadge() {
      const badge = document.getElementById('api-status-badge');
      const hasKey = Boolean(localStorage.getItem('nipun_gemini_key'));
      if (hasKey) {
        badge.textContent = 'Live API Key';
        badge.className = 'px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 font-medium';
      } else {
        badge.textContent = 'Demo Mode';
        badge.className = 'px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 font-medium';
      }
    }

    function appendMessage(role, text) {
      const box = document.getElementById('chat-messages');
      const wrapper = document.createElement('div');
      wrapper.className = role === 'user' ? 'flex justify-end' : 'flex justify-start';

      const bubble = document.createElement('div');
      bubble.className = role === 'user'
        ? 'max-w-[82%] bg-indigo-600 text-white px-4 py-3 rounded-2xl rounded-tr-sm text-sm leading-relaxed whitespace-pre-wrap'
        : 'max-w-[82%] bg-slate-800 text-slate-100 px-4 py-3 rounded-2xl rounded-tl-sm text-sm leading-relaxed whitespace-pre-wrap';
      bubble.textContent = text;

      wrapper.appendChild(bubble);
      box.appendChild(wrapper);
      box.scrollTop = box.scrollHeight;
    }

    function clearChat() {
      const box = document.getElementById('chat-messages');
      box.innerHTML = '';
      appendMessage('ai', 'Chat එක Clear කළා. අලුත් ප්‍රශ්නයක් අහන්න!');
    }

    async function sendMessage() {
      const input = document.getElementById('chat-input');
      const typing = document.getElementById('chat-typing');
      const prompt = input.value.trim();
      if (!prompt) return;

      appendMessage('user', prompt);
      input.value = '';
      typing.classList.remove('hidden');

      const apiKey = localStorage.getItem('nipun_gemini_key') || '';

      if (!apiKey) {
        setTimeout(() => {
          typing.classList.add('hidden');
          appendMessage(
            'ai',
            `Demo Mode පිළිතුර:\nඔයා "${prompt}" ගැන ඇසුවා.\n\nසජීවී Gemini පිළිතුරු ලබාගන්න Google AI Studio වෙතින් API Key එකක් ලබාගෙන ඉහළ ඇති Gemini API Key කොටුවේ Save කරන්න.`
          );
        }, 650);
        return;
      }

      try {
        const endpoint = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${encodeURIComponent(apiKey)}`;
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            contents: [{ parts: [{ text: prompt }] }]
          })
        });

        const data = await response.json();
        typing.classList.add('hidden');

        if (!response.ok) {
          appendMessage('ai', `API දෝෂයක්: ${data.error?.message || 'API Key එක පරීක්ෂා කරන්න.'}`);
          return;
        }

        const reply = data.candidates?.[0]?.content?.parts?.[0]?.text || 'පිළිතුරක් ලබාගත නොහැකි විය.';
        appendMessage('ai', reply);
      } catch (err) {
        typing.classList.add('hidden');
        appendMessage('ai', 'Network දෝෂයක් ඇති වුණා. Internet සම්බන්ධතාවය පරීක්ෂා කරන්න.');
      }
    }

    // ---------- AI IMAGE STUDIO ----------
    function setPrompt(text) {
      document.getElementById('img-prompt').value = text;
    }

    function generateImage() {
      const promptInput = document.getElementById('img-prompt');
      const sizeSelect = document.getElementById('img-size');
      const loading = document.getElementById('img-loading');
      const result = document.getElementById('img-result');
      const imgEl = document.getElementById('generated-img');
      const captionEl = document.getElementById('img-caption');
      const downloadBtn = document.getElementById('download-img-btn');

      const prompt = promptInput.value.trim();
      if (!prompt) {
        promptInput.focus();
        return;
      }

      const [width, height] = sizeSelect.value.split('x');
      const seed = Math.floor(Math.random() * 1000000);
      const url = `https://image.pollinations.ai/prompt/${encodeURIComponent(prompt)}?width=${width}&height=${height}&seed=${seed}&nologo=true`;

      result.classList.add('hidden');
      loading.classList.remove('hidden');

      imgEl.onload = () => {
        loading.classList.add('hidden');
        result.classList.remove('hidden');
