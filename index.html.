  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col md:flex-row antialiased">

  <!-- Sidebar -->
  <aside class="w-full md:w-72 bg-slate-900/90 border-b md:border-b-0 md:border-r border-slate-800 p-5 flex flex-col justify-between shrink-0">
    <div>
      <div class="flex items-center gap-3 mb-8">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 via-purple-500 to-cyan-400 flex items-center justify-center font-bold text-slate-950 text-lg shadow-lg shadow-indigo-500/20">
          N
        </div>
        <div>
          <h1 class="text-xl font-bold bg-gradient-to-r from-indigo-400 via-purple-300 to-cyan-300 bg-clip-text text-transparent">
            Nipun AI Tools
          </h1>
          <p class="text-xs text-slate-400">All-in-One AI Workspace</p>
        </div>
      </div>

      <nav class="space-y-2" aria-label="Main Navigation">
        <button data-tab="chat" onclick="switchTab('chat')"
          class="nav-btn w-full flex items-center gap-3 px-4 py-3 rounded-xl text-left font-medium transition bg-indigo-600 text-white shadow-md shadow-indigo-600/20">
          <span>💬</span>
          <span>Nipun AI Chat</span>
        </button>

        <button data-tab="image" onclick="switchTab('image')"
